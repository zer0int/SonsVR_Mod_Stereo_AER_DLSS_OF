	<!--
	  All external references resolve through these two roots.
	  Override either one without editing this file, e.g.:
	      dotnet build -p:GameDir="D:\Games\Sons Of The Forest"
	  or by setting a GameDir / RefDir environment variable.

	  RefDir  = install whose MelonLoader folder provides the reference assemblies
	            (Il2CppAssemblies, Managed, net6, Dependencies).
	  GameDir = playable install the built mod is deployed into.
	  They may be the same directory; they are kept separate here because the
	  reference assemblies were generated from a different copy of the game.
	-->
	<PropertyGroup>
		<RefDir Condition="'$(RefDir)' == ''">E:\VR GAME MODDING WIP\SonsOfThe Forest_ML</RefDir>
		<GameDir Condition="'$(GameDir)' == ''">E:\FLAT GAMES\Sons Of The Forest</GameDir>
		<MelonDir>$(RefDir)\MelonLoader</MelonDir>
	</PropertyGroup>

	<ItemGroup>
	  <EmbeddedResource Remove="Libs\**" />
	  <None Remove="Libs\**" />
	</ItemGroup>

